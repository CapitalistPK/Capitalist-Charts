{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@capitalist-charts/schema": ["packages/schema/src/index.ts"],
      "@capitalist-charts/schema/*": ["packages/schema/src/*.ts"],
      "@capitalist-charts/core": ["packages/core/src/index.ts"],
      "@capitalist-charts/core/render": ["packages/core/src/render.ts"],
      "@capitalist-charts/core/analytics": ["packages/core/src/analytics.ts"],
      "@capitalist-charts/elements": ["packages/elements/src/index.ts"],
      "@capitalist-charts/elements/catalog": ["packages/elements/src/catalog.ts"],
      "@capitalist-charts/react": ["packages/react/src/index.ts"],
      "@capitalist-charts/ssr": ["packages/ssr/src/index.ts"]
    }
  },
  "include": ["packages/*/src", "packages/*/test", "vitest.config.ts"]
}
