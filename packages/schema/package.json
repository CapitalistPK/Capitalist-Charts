{
  "name": "@capitalist-charts/schema",
  "version": "1.0.1",
  "description": "Wire types for Capitalist Charts widget data.",
  "keywords": [
    "capitalist-charts",
    "widgets",
    "web-components",
    "financial-charts",
    "stock-market",
    "market-data",
    "psx",
    "pakistan",
    "embeddable",
    "typescript",
    "types",
    "json-schema"
  ],
  "homepage": "https://github.com/CapitalistPK/Capitalist-Charts/tree/main/packages/schema#readme",
  "bugs": {
    "url": "https://github.com/CapitalistPK/Capitalist-Charts/issues"
  },
  "author": "Capitalist (https://capitalist.pk)",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./base": {
      "types": "./dist/base.d.ts",
      "import": "./dist/base.js"
    },
    "./views": {
      "types": "./dist/views.d.ts",
      "import": "./dist/views.js"
    },
    "./analytics": {
      "types": "./dist/analytics.d.ts",
      "import": "./dist/analytics.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/base.ts src/views.ts src/analytics.ts --format esm --dts --clean --target es2022",
    "prepublishOnly": "pnpm run build && node ../../scripts/pack-check.mjs"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CapitalistPK/Capitalist-Charts.git",
    "directory": "packages/schema"
  }
}
